# Copiar este archivo a .env y completar con las claves reales.
# .env NUNCA se sube al repositorio (ver .gitignore).

# Groq (generador 1, capa gratuita) - https://console.groq.com/keys
GROQ_API_KEY=

# Cohere (generador 2, capa gratuita "trial") - https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# Google AI Studio / Gemini (generador 3, capa gratuita) - https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# HuggingFace (descarga del SLM candidato, ej. Llama 3.2 3B - modelo con
# acceso restringido: acepta la licencia en la ficha del modelo y genera
# un token de lectura en https://huggingface.co/settings/tokens)
HF_TOKEN=

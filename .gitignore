# Entorno y credenciales
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Modelos y datos pesados
*.bin
*.safetensors
*.gguf
checkpoints/
outputs/
wandb/

# Excepción: adaptadores LoRA (pocos MB, no pesan como un modelo
# completo — sí queremos versionarlos, a diferencia de checkpoints/
# de entrenamiento o los pesos del modelo base). Sin acotar a
# finetuning/ -- api/space/adapter/ (Sesión 26) también los necesita,
# y hasta ahora esto solo cubría finetuning/, dejando
# api/space/adapter/adapter_model.safetensors sin subir en su primer
# commit (bug real encontrado y corregido en la misma sesión).
!**/adapter/*.safetensors
!**/adapter/*.bin

# Excepción: finetuning/checkpoints/<generadorN>/ guarda el adaptador
# LoRA FINAL del entrenamiento completo (Sesión 19+) — choca de nombre
# con la regla genérica "checkpoints/" de arriba (pensada para
# checkpoints INTERMEDIOS de entrenamiento, que entrenar_lora.py nunca
# guarda dentro del repo, ver su docstring). Sin este !, git ni
# siquiera miraría dentro de la carpeta para aplicar la excepción de
# *.safetensors/*.bin de arriba.
!finetuning/checkpoints/

# SO / editores
.DS_Store
.vscode/
.idea/

# LaTeX: artefactos de compilación (no el .tex ni el .pdf final, esos
# sí se versionan como fuente y como evidencia de compilación limpia)
paper/*.aux
paper/*.log
paper/*.out
paper/*.toc
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz
